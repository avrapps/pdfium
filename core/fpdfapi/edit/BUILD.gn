import("../../../pdfium.gni")
import("../../../testing/test.gni")

source_set("edit") {
  sources = [
    "cpdf_creator.cpp",
    "cpdf_creator.h",
    "cpdf_npagetooneexporter.cpp",
    "cpdf_npagetooneexporter.h",
    "cpdf_pagecontentgenerator.cpp",
    "cpdf_pagecontentgenerator.h",
    "cpdf_pagecontentmanager.cpp",
    "cpdf_pagecontentmanager.h",
    "cpdf_pageexporter.cpp",
    "cpdf_pageexporter.h",
    "cpdf_pageorganizer.cpp",
    "cpdf_pageorganizer.h",
    "cpdf_stringarchivestream.cpp",
    "cpdf_stringarchivestream.h",
    "cpdf_text_redactor.cpp",
    "cpdf_text_redactor.h",
  ]

  if (pdf_enable_font_sanitizer) {
    sources += [
      "cpdf_font_sanitizer.cpp",
      "cpdf_font_sanitizer.h",
      "cpdf_font_subsetter.cpp",
      "cpdf_font_subsetter.h",
      "cpdf_font_usage_collector.cpp",
      "cpdf_font_usage_collector.h",
      "cpdf_tounicode_builder.cpp",
      "cpdf_tounicode_builder.h",
      "cpdf_type3_pruner.cpp",
      "cpdf_type3_pruner.h",
    ]
  }

  configs += [
    "../../../:pdfium_strict_config",
    "../../../:pdfium_noshorten_config",
  ]
  deps = [
    ":contentstream_write_utils",
    "../../../constants",
    "../../fxcrt",
    "../font",
    "../page",
    "../parser",
  ]

  if (pdf_enable_font_sanitizer) {
    deps += [ "//third_party:harfbuzz" ]
    defines = [ "PDF_ENABLE_FONT_SANITIZER" ]
  }

  visibility = [ "../../../*" ]
}

source_set("contentstream_write_utils") {
  sources = [
    "cpdf_contentstream_write_utils.cpp",
    "cpdf_contentstream_write_utils.h",
  ]
  configs += [
    "../../../:pdfium_strict_config",
    "../../../:pdfium_noshorten_config",
  ]
  deps = [ "../../fxcrt" ]
}

pdfium_unittest_source_set("unittests") {
  sources = [
    "cpdf_npagetooneexporter_unittest.cpp",
    "cpdf_pagecontentgenerator_unittest.cpp",
  ]
  if (pdf_enable_font_sanitizer) {
    sources += [ "cpdf_font_sanitizer_unittest.cpp" ]
  }
  deps = [
    ":edit",
    "../../fxge",
    "../font",
    "../page",
    "../page:unit_test_support",
    "../parser",
    "../parser:unit_test_support",
    "../render",
  ]
  pdfium_root_dir = "../../../"
}

pdfium_embeddertest_source_set("embeddertests") {
  sources = [ "cpdf_creator_embeddertest.cpp" ]
  pdfium_root_dir = "../../../"
}
